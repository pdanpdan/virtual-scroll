{
  "name": "@pdanpdan/virtual-scroll",
  "type": "module",
  "version": "2.1.1",
  "description": "Virtual scrolling for Vue 3: only the rows near the viewport are in the DOM.",
  "author": "Dan Popescu <pdan.popescu@gmail.com>",
  "license": "MIT",
  "homepage": "https://pdanpdan.github.io/virtual-scroll",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pdanpdan/virtual-scroll.git",
    "directory": "packages/virtual-scroll"
  },
  "bugs": {
    "url": "https://github.com/pdanpdan/virtual-scroll/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "virtual-scroll",
    "virtual-list",
    "virtualization",
    "windowing",
    "infinite-scroll",
    "dynamic-size",
    "grid",
    "table",
    "masonry",
    "ssr",
    "performance",
    "typescript"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/index.d.ts",
      "import": "./dist/core.mjs",
      "require": "./dist/core.cjs"
    },
    "./core/style.css": "./dist/core.css",
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.mjs",
      "require": "./dist/internal.cjs"
    },
    "./VirtualScroll.vue": "./src/components/VirtualScroll.vue",
    "./VirtualScrollTable.vue": "./src/components/VirtualScrollTable.vue",
    "./VirtualScrollMasonry.vue": "./src/components/VirtualScrollMasonry.vue",
    "./VirtualScrollbar.vue": "./src/components/VirtualScrollbar.vue",
    "./style.css": "./dist/virtual-scroll.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "unpkg": "./dist/index.js",
  "jsdelivr": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "AGENTS.md",
    "dist",
    "src"
  ],
  "scripts": {
    "build": "vite build && vite build --config vite.config.core.ts && vite build --config vite.config.umd.ts",
    "size": "node scripts/size.ts",
    "prepublishOnly": "pnpm build",
    "lint": "pnpm --dir ../.. lint",
    "lint:fix": "pnpm --dir ../.. lint:fix",
    "test": "vitest run",
    "test:ui": "vitest --ui --coverage.enabled --coverage.reporter=html",
    "test:watch": "vitest",
    "test:types": "vue-tsc -p tsconfig.app.json --noEmit && vue-tsc -p tsconfig.vitest.json --noEmit",
    "test:coverage": "vitest run --coverage",
    "test:all": "pnpm run lint && pnpm run test:types && pnpm run test:coverage && pnpm run size"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "catalog:",
    "@vue/test-utils": "catalog:",
    "@vue/tsconfig": "catalog:",
    "browserslist": "catalog:",
    "jsdom": "catalog:",
    "lightningcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  },
  "browserslist": [
    ">0.5%, baseline widely available"
  ]
}
