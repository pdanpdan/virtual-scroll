{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "target": "ES2022",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "#/*": [
        "./*"
      ],
      "@pdanpdan/virtual-scroll/internal": [
        "../virtual-scroll/src/internal.ts"
      ],
      "@pdanpdan/virtual-scroll": [
        "../virtual-scroll/src/index.ts"
      ]
    },
    "types": [
      "vite/client",
      "vue"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "**/*.ts",
    "**/*.vue",
    "**/*.json",
    "env.d.ts",
    "../virtual-scroll/src/**/*.ts",
    "../virtual-scroll/src/**/*.vue"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tmp-generated"
  ]
}
